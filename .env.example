# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster details with your own credentials from MongoDB Atlas:
# Example: mongodb+srv://myuser:mypassword123@cluster0.abcde.mongodb.net/backendTutorial?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/backendTutorial?retryWrites=true&w=majority
